---
// The room under the pond (docs/decisions/0030), at /room: a preview nothing links to yet and
// search engines are asked to leave alone (the robots tag here, and astro.config.mjs keeps it
// out of the sitemap). It stands apart from Layout.astro, whose head describes the site for
// link previews and search, which this page is not for.
//
// The page is a canvas and a few things over it: a note (loading, or why there is no room), the
// way back from a screen, beside it at the right screen a link to the desktop that screen shows,
// and a field nobody sees, which holds what is typed at the laptop's terminal (so that a phone
// brings its keyboard up for it). The site's desktop, when the camera is at the right screen, is a
// frame that src/room/main.js adds and takes away. The scene's code (src/room/, with three.js) is
// this page's own script and in no other page's bundle; it starts once the browser has shown it
// has WebGL.
// vercel.json gives this path its own Content Security Policy for what three.js needs.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#07080b" />
    <title>Room</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #07080b;
        overflow: hidden;
      }
      canvas {
        display: block;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        touch-action: none;
      }
      #note {
        position: fixed;
        left: 50%;
        top: 50%;
        width: max-content;
        max-width: calc(100vw - 48px);
        margin: 0;
        transform: translate(-50%, -50%);
        color: #8a8f9a;
        font:
          13px/1.5 system-ui,
          -apple-system,
          'Segoe UI',
          Roboto,
          sans-serif;
        letter-spacing: 0.04em;
        text-align: center;
        transition: opacity 0.6s;
        /* the only sign of loading: the words breathe */
        animation: wait 2.4s ease-in-out infinite alternate;
      }
      @keyframes wait {
        from {
          opacity: 1;
        }
        to {
          opacity: 0.45;
        }
      }
      body[data-ready] #note {
        animation: none;
        opacity: 0;
        pointer-events: none;
      }
      /* something went wrong: the words stay, and stay still */
      body[data-failed] #note {
        animation: none;
        opacity: 1;
        color: #b9bdc6;
      }
      body[data-failed] canvas {
        display: none;
      }
      /* the way back from a screen, and the way to the desktop the right screen shows: each
         shown only while the camera is up at a screen (the second, at the right one) */
      #controls {
        position: fixed;
        left: max(18px, env(safe-area-inset-left));
        top: max(18px, env(safe-area-inset-top));
        display: flex;
        gap: 8px;
        pointer-events: none;
      }
      #back,
      #full {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px 8px 10px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 999px;
        background: rgba(14, 17, 23, 0.62);
        -webkit-backdrop-filter: blur(14px) saturate(1.3);
        backdrop-filter: blur(14px) saturate(1.3);
        color: #e9e4da;
        font:
          500 13px/1 system-ui,
          -apple-system,
          'Segoe UI',
          Roboto,
          sans-serif;
        letter-spacing: 0.02em;
        text-decoration: none;
        cursor: pointer;
        opacity: 0;
        transform: translateY(-6px);
        pointer-events: none;
        transition:
          opacity 0.35s ease,
          transform 0.35s ease,
          background 0.15s ease;
      }
      #full {
        padding: 8px 12px 8px 14px;
        color: #b9bdc6;
        font-weight: 400;
      }
      #back svg,
      #full svg {
        display: block;
      }
      #back:hover,
      #full:hover {
        background: rgba(34, 39, 49, 0.78);
      }
      #back:focus-visible,
      #full:focus-visible {
        outline: 2px solid #f0ae62;
        outline-offset: 2px;
      }
      body[data-focused] #back,
      body[data-focused='dell'] #full {
        opacity: 1;
        transform: none;
        pointer-events: auto;
        transition-delay: 0.35s, 0.35s, 0s;
      }
      /* the terminal's field: on the page so it can hold the keyboard, and not to be seen. At
         the top, where a phone need not scroll to it; 16px, under which iOS zooms in on a field. */
      #keys {
        position: fixed;
        left: 0;
        top: 0;
        width: 1px;
        height: 1px;
        padding: 0;
        border: 0;
        outline: 0;
        background: none;
        color: transparent;
        caret-color: transparent;
        font-size: 16px;
        opacity: 0;
        pointer-events: none;
      }
      @media (prefers-reduced-motion: reduce) {
        #back,
        #full {
          transition: none;
        }
        #note {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="room" aria-label="A desk at dusk, seen from its seat: a laptop, two monitors above it, and behind them a window on a balcony and trees, in the season of the year. Pressing the view outside turns the season. Pressing a screen goes up to it: the left one is a map of places visited, the laptop has an editor and a terminal that takes commands, the right one is this site's desktop."></canvas>
    <input id="keys" type="text" tabindex="-1" maxlength="200" aria-label="The terminal on the laptop's screen: type help and press Enter" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="go" />
    <div id="controls">
      <button id="back" type="button" tabindex="-1" aria-label="Back to the desk">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8.5 2.5 4 7l4.5 4.5"></path>
        </svg>
        Back
      </button>
      <a id="full" href="/os" tabindex="-1" aria-label="Open the desktop in the whole window">
        Open in full
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.5 2.5h5v5M9.5 2.5 3 9"></path>
        </svg>
      </a>
    </div>
    <p id="note" role="status">Loading the room</p>
    <noscript>
      <style>
        #note { display: none; }
        .plain { position: fixed; inset: 0; display: grid; place-items: center; margin: 0; color: #b9bdc6; font: 13px/1.5 system-ui, sans-serif; }
      </style>
      <p class="plain">The room needs JavaScript to be drawn.</p>
    </noscript>
    <script src="../room/boot.ts"></script>
  </body>
</html>
